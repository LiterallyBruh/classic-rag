# Скопируйте в .env и заполните. .env в .gitignore — секреты не коммитятся.

# Вариант 1 (приоритетный, если задан): GigaChat — авторизационный ключ
# из личного кабинета https://developers.sber.ru/studio
GIGACHAT_AUTH_KEY=
# GIGACHAT_MODEL=GigaChat
# GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Вариант 2: любой OpenAI-совместимый эндпоинт
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
